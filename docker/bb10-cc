#!/usr/bin/env python3
"""gcc-compatible C/C++ driver for BB10 (QNX 6.6, ARMv7, softfp).

The single place that knows how to build for BB10. clang has no QNX linker
driver, so this compiles with clang for the bare-metal armv7-none-eabi triple
plus the BB10 sysroot flags, and links with the armnto GNU ld. Invoked as
bb10-c++, it compiles C++ and links the C++ runtime. The CMake toolchain uses
it as its compiler and linker; cgo uses it as CC/CXX.
"""
import os
import subprocess
import sys
import tempfile

TARGET = os.environ.get("QNX_TARGET", "/opt/bb10-sdk/target/qnx6")
BINUTILS = "/opt/bb10-toolchain/bin/arm-unknown-nto-qnx6.5.0eabi-"
BUILTINS = "/opt/bb10-toolchain/lib/libclang_rt.builtins-armv7.a"
LIB = TARGET + "/armle-v7/lib"
USR_LIB = TARGET + "/armle-v7/usr/lib"
QT_LIB = USR_LIB + "/qt4/lib"
CXX = os.path.basename(sys.argv[0]).endswith("++")


def compile_flags():
    resource = subprocess.run(["clang", "-print-resource-dir"], capture_output=True, text=True, check=True).stdout.strip()
    flags = ["--target=armv7-none-eabi", "-fPIC", "-marm", "-mcpu=cortex-a9", "-mfpu=vfpv3-d16",
             "-mfloat-abi=softfp", "-mno-unaligned-access", "-Wno-pragma-pack", "-fstack-protector", "-nostdinc",
             "-D__QNX__", "-D__QNXNTO__", "-D__unix__", "-D__unix", "-D__ARM__", "-D__LITTLEENDIAN__",
             "-D_QNX_SOURCE", "-isystem", resource + "/include",
             "-isystem", "/opt/bb10-target-override/usr/include"]
    if CXX:
        flags += ["-std=gnu++98", "-fno-exceptions", "-fno-rtti", "-DQT_NO_EXCEPTIONS",
                  "-isystem", TARGET + "/usr/include/cpp", "-isystem", TARGET + "/usr/include/cpp/c"]
    flags += ["-isystem", TARGET + "/usr/include"]
    if CXX:
        flags += ["-isystem", TARGET + "/usr/include/qt4", "-isystem", TARGET + "/usr/include/qt4/QtCore",
                  "-isystem", TARGET + "/usr/include/qt4/QtDeclarative"]
    return flags


def clang(args):
    return subprocess.call(["clang++" if CXX else "clang"] + compile_flags() + args)


SOURCE_EXT = (".c", ".cc", ".cpp", ".cxx", ".s", ".S")
# Compile options whose value is the next argument.
TWO_ARG = {"-isystem", "-include", "-I", "-iquote", "-idirafter", "-x", "-MF", "-MT", "-MQ", "-Xclang", "-target"}
# gcc options that only matter to gcc's own link step, or that ld does not need.
IGNORED_LINK = {"-pthread", "-no-pie", "-g", "-rdynamic"}


def link(args):
    out, objs, ld_args, libs, cflags = "a.out", [], [], [], []
    shared = False
    sources = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-o":
            out = args[i + 1]; i += 2; continue
        if a.startswith("-Wl,"):
            ld_args += a[4:].split(",")
        elif a == "-Xlinker":
            ld_args.append(args[i + 1]); i += 1
        elif a.startswith("-L"):
            ld_args.append(a if len(a) > 2 else "-L" + args[i + 1]); i += (0 if len(a) > 2 else 1)
        elif a.startswith("-l"):
            libs.append(a)
        elif a == "-shared":
            shared = True
        elif a == "-rdynamic":
            ld_args.append("--export-dynamic")
        elif a in ("-s", "-S"):
            ld_args.append(a)  # strip all / strip debug info, at link time
        elif a in TWO_ARG and i + 1 < len(args):
            cflags += [a, args[i + 1]]; i += 1
        elif a.endswith(SOURCE_EXT) and not a.startswith("-"):
            sources.append(a)
        elif a.startswith("-") or a in IGNORED_LINK:
            cflags.append(a)  # -O2, -m..., -f..., -g...: compile-only or harmless
        else:
            objs.append(a)
        i += 1

    with tempfile.TemporaryDirectory() as tmp:
        for n, src in enumerate(sources):
            obj = os.path.join(tmp, "src%d.o" % n)
            keep = [f for f in cflags if f.startswith(("-D", "-I", "-std", "-O", "-f", "-W", "-isystem", "-include"))
                    or not f.startswith("-")]
            if clang(keep + ["-c", src, "-o", obj]) != 0:
                return 1
            objs.append(obj)
        common = ["-m", "armnto", "-z", "noexecstack", "-rpath-link", LIB, "-rpath-link", USR_LIB,
                  "-rpath-link", QT_LIB, "-L" + LIB, "-L" + LIB + "/gcc/4.6.3", "-L" + USR_LIB, "-L" + QT_LIB]
        runtime = (["-lcpp"] if CXX else []) + ["-lm", "-lc", BUILTINS]
        if shared:
            cmd = [BINUTILS + "ld", "-shared"] + common + ld_args + ["-o", out] + objs + libs + [BUILTINS]
        else:
            cmd = ([BINUTILS + "ld", "--dynamic-linker", "/usr/lib/ldqnx.so.2", "--hash-style=sysv"] + common
                   + ld_args + ["-o", out, LIB + "/crt1.o", LIB + "/crti.o"] + objs + libs
                   + runtime[:-2] + ["-lbps"] + runtime[-2:]
                   + [LIB + "/crtn.o"])
        if os.environ.get("BB10_CC_VERBOSE"):
            print(" ".join(cmd), file=sys.stderr)
        return subprocess.call(cmd)


def main():
    args = sys.argv[1:]
    if not args or any(a in ("-c", "-S", "-E", "-M", "-MM", "--version", "-v", "-dumpversion", "-dumpmachine")
                       or a.startswith("-print-") for a in args):
        return clang(args)
    return link(args)


sys.exit(main())
