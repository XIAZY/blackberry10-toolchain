#!/usr/bin/env python3
"""gcc-compatible C/C++ driver for BB10 (QNX 6.6).

The single place that knows how to build for BB10. QNX_ARCH chooses the
architecture: arm (the default; ARMv7, softfp: the phones) or x86 (the BB10
simulator). clang has no QNX linker driver. For arm this compiles with clang
for the bare-metal armv7-none-eabi triple plus the BB10 sysroot flags, and
links with the armnto GNU ld. For x86 it compiles for the i386 SysV ABI with
the Linux-specific parts of clang's driver turned off, and links with lld.
Invoked as bb10-c++, it compiles C++ and links the C++ runtime. The CMake
toolchain uses it as its compiler and linker; cgo uses it as CC/CXX.

x86 programs have only been built, never run: there is no BB10 simulator
to run them on.
"""
import os
import subprocess
import sys
import tempfile

TARGET = os.environ.get("QNX_TARGET", "/opt/bb10-sdk/target/qnx6")
ARCH = os.environ.get("QNX_ARCH", "arm")
if ARCH not in ("arm", "x86"):
    sys.exit("bb10-cc: QNX_ARCH must be arm or x86, not " + ARCH)
X86 = ARCH == "x86"
BINUTILS = "/opt/bb10-toolchain/bin/arm-unknown-nto-qnx6.5.0eabi-"
BUILTINS = ("/opt/bb10-toolchain/lib/bb10-x86/libclang_rt.builtins-i386.a" if X86
            else "/opt/bb10-toolchain/lib/libclang_rt.builtins-armv7.a")
LIB = TARGET + ("/x86/lib" if X86 else "/armle-v7/lib")
USR_LIB = TARGET + ("/x86/usr/lib" if X86 else "/armle-v7/usr/lib")
QT_LIB = USR_LIB + "/qt4/lib"
CXX = os.path.basename(sys.argv[0]).endswith("++")


def compile_flags():
    resource = subprocess.run(["clang", "-print-resource-dir"], capture_output=True, text=True, check=True).stdout.strip()
    if X86:
        # The guard is BB10 libc's __stack_chk_guard, not the %gs slot that
        # clang's Linux target reads. Thread-local storage is emulated, as
        # QNX's loader has no TLS segment.
        flags = ["--target=i386-pc-linux-gnu", "-march=i686", "-fPIC", "-mstack-alignment=4",
                 "-femulated-tls", "-mstack-protector-guard=global",
                 "-U__linux__", "-U__linux", "-Ulinux", "-U__gnu_linux__", "-Uunix",
                 "-U__FLOAT128__", "-U__SIZEOF_FLOAT128__", "-D__X86__", "-D__ELF__",
                 "-Wno-unused-command-line-argument"]
    else:
        flags = ["--target=armv7-none-eabi", "-fPIC", "-marm", "-mcpu=cortex-a9", "-mfpu=vfpv3-d16",
                 "-mfloat-abi=softfp", "-mno-unaligned-access", "-D__ARM__"]
    flags += ["-Wno-pragma-pack", "-fstack-protector", "-nostdinc",
              "-D__QNX__", "-D__QNXNTO__", "-D__unix__", "-D__unix", "-D__LITTLEENDIAN__",
              "-D_QNX_SOURCE", "-isystem", resource + "/include",
              "-isystem", "/opt/bb10-target-override/usr/include"]
    if CXX:
        flags += ["-std=gnu++98", "-fno-exceptions", "-fno-rtti", "-DQT_NO_EXCEPTIONS",
                  "-isystem", TARGET + "/usr/include/cpp", "-isystem", TARGET + "/usr/include/cpp/c"]
    flags += ["-isystem", TARGET + "/usr/include"]
    if CXX:
        flags += ["-isystem", TARGET + "/usr/include/qt4", "-isystem", TARGET + "/usr/include/qt4/QtCore",
                  "-isystem", TARGET + "/usr/include/qt4/QtDeclarative"]
    return flags


def clang(args):
    return subprocess.call(["clang++" if CXX else "clang"] + compile_flags() + args)


SOURCE_EXT = (".c", ".cc", ".cpp", ".cxx", ".s", ".S")
# Compile options whose value is the next argument.
TWO_ARG = {"-isystem", "-include", "-I", "-iquote", "-idirafter", "-x", "-MF", "-MT", "-MQ", "-Xclang", "-target"}
# gcc options that only matter to gcc's own link step, or that ld does not need.
IGNORED_LINK = {"-pthread", "-no-pie", "-g", "-rdynamic"}


def link(args):
    out, objs, ld_args, libs, cflags = "a.out", [], [], [], []
    shared = False
    sources = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-o":
            out = args[i + 1]; i += 2; continue
        if a.startswith("-Wl,"):
            ld_args += a[4:].split(",")
        elif a == "-Xlinker":
            ld_args.append(args[i + 1]); i += 1
        elif a.startswith("-L"):
            ld_args.append(a if len(a) > 2 else "-L" + args[i + 1]); i += (0 if len(a) > 2 else 1)
        elif a.startswith("-l"):
            libs.append(a)
        elif a == "-shared":
            shared = True
        elif a == "-rdynamic":
            ld_args.append("--export-dynamic")
        elif a in ("-s", "-S"):
            ld_args.append(a)  # strip all / strip debug info, at link time
        elif a in TWO_ARG and i + 1 < len(args):
            cflags += [a, args[i + 1]]; i += 1
        elif a.endswith(SOURCE_EXT) and not a.startswith("-"):
            sources.append(a)
        elif a.startswith("-") or a in IGNORED_LINK:
            cflags.append(a)  # -O2, -m..., -f..., -g...: compile-only or harmless
        else:
            objs.append(a)
        i += 1

    with tempfile.TemporaryDirectory() as tmp:
        for n, src in enumerate(sources):
            obj = os.path.join(tmp, "src%d.o" % n)
            keep = [f for f in cflags if f.startswith(("-D", "-I", "-std", "-O", "-f", "-W", "-isystem", "-include"))
                    or not f.startswith("-")]
            if clang(keep + ["-c", src, "-o", obj]) != 0:
                return 1
            objs.append(obj)
        ld = "ld.lld" if X86 else BINUTILS + "ld"
        common = ["-m", "elf_i386" if X86 else "armnto", "-z", "noexecstack", "-rpath-link", LIB, "-rpath-link", USR_LIB,
                  "-rpath-link", QT_LIB, "-L" + LIB, "-L" + LIB + "/gcc/4.6.3", "-L" + USR_LIB, "-L" + QT_LIB]
        runtime = (["-lcpp"] if CXX else []) + ["-lm", "-lc", BUILTINS]
        if shared:
            cmd = [ld, "-shared"] + common + ld_args + ["-o", out] + objs + libs + [BUILTINS]
        else:
            cmd = ([ld, "--dynamic-linker", "/usr/lib/ldqnx.so.2", "--hash-style=sysv"] + common
                   + ld_args + ["-o", out, LIB + "/crt1.o", LIB + "/crti.o"] + objs + libs
                   + runtime[:-2] + ["-lbps"] + runtime[-2:]
                   + [LIB + "/crtn.o"])
        if os.environ.get("BB10_CC_VERBOSE"):
            print(" ".join(cmd), file=sys.stderr)
        return subprocess.call(cmd)


def main():
    args = sys.argv[1:]
    if not args or any(a in ("-c", "-S", "-E", "-M", "-MM", "--version", "-v", "-dumpversion", "-dumpmachine")
                       or a.startswith("-print-") for a in args):
        return clang(args)
    return link(args)


sys.exit(main())
