#!/bin/sh
set -eu

target=arm-unknown-nto-qnx6.5.0eabi
failed=0

check_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "error: missing command: $1" >&2
        failed=1
    fi
}

for command in \
    clang \
    clang++ \
    "$target-ld" \
    "$target-as" \
    "$target-readelf" \
    blackberry-nativepackager; do
    check_command "$command"
done

if command -v qcc >/dev/null 2>&1; then
    echo "error: qcc must not be present in the builder image" >&2
    failed=1
fi

if [ ! -f "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/usr/include/bb/cascades/Application" ] && \
   [ ! -f "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/usr/include/bb/cascades/Application.hpp" ]; then
    echo "error: Cascades headers are missing from the target sysroot" >&2
    failed=1
fi

if [ ! -e "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/armle-v7/usr/lib/libbbcascades.so" ]; then
    echo "error: libbbcascades.so is missing from the target sysroot" >&2
    failed=1
fi

for tool in "moc -v" "rcc -version" "uic -v"; do
    if ! /opt/bb10-qt4/bin/$tool 2>&1 | grep -q "version.* 4\.8\.6"; then
        echo "error: Qt 4.8.6 ${tool%% *} is missing or does not run" >&2
        failed=1
    fi
done

if [ ! -f /opt/bb10-toolchain/lib/libclang_rt.builtins-armv7.a ]; then
    echo "error: compiler-rt builtins for armv7 are missing" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

if ! "$target-ld" -V 2>&1 | grep -q armnto; then
    echo "error: GNU ld does not contain armnto emulation" >&2
    exit 1
fi

echo "modern compiler: $(clang++ --version | head -n 1)"
echo "modern linker: $($target-ld --version | head -n 1)"
echo "builder process architecture: $(uname -m)"
echo "linker output profile: armnto (GNU ld calls this an emulation; no CPU emulation)"
echo "qcc: absent"
echo "BB10 Cascades SDK: present"
echo "Qt host tools: $(/opt/bb10-qt4/bin/moc -v 2>&1)"

# Configure, moc, compile and link a probe with the real toolchain file and link
# rules: QNX predefines, ABI sizes, a Q_OBJECT class and every runtime helper.
selftest=$(mktemp -d)
if ! cmake -S /opt/bb10-cmake/selftest -B "$selftest" \
        -DCMAKE_TOOLCHAIN_FILE=/opt/bb10-toolchain.cmake >"$selftest.log" 2>&1 || \
   ! cmake --build "$selftest" >>"$selftest.log" 2>&1; then
    cat "$selftest.log" >&2
    echo "error: toolchain self-test failed" >&2
    exit 1
fi
rm -rf "$selftest" "$selftest.log"
echo "self-test: moc, QNX ABI checks and runtime helpers link"

if [ "${1:-}" != "--image-build" ]; then
    echo "toolchain is ready"
fi
