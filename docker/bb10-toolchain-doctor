#!/bin/sh
set -eu

target=arm-unknown-nto-qnx6.5.0eabi
failed=0

check_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "error: missing command: $1" >&2
        failed=1
    fi
}

for command in \
    clang \
    clang++ \
    "$target-ld" \
    "$target-as" \
    "$target-readelf" \
    blackberry-nativepackager; do
    check_command "$command"
done

if command -v qcc >/dev/null 2>&1; then
    echo "error: qcc must not be present in the builder image" >&2
    failed=1
fi

if [ ! -f "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/usr/include/bb/cascades/Application" ] && \
   [ ! -f "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/usr/include/bb/cascades/Application.hpp" ]; then
    echo "error: Cascades headers are missing from the target sysroot" >&2
    failed=1
fi

if [ ! -e "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/armle-v7/usr/lib/libbbcascades.so" ]; then
    echo "error: libbbcascades.so is missing from the target sysroot" >&2
    failed=1
fi

for tool in "moc -v" "rcc -version" "uic -v"; do
    if ! /opt/bb10-qt4/bin/$tool 2>&1 | grep -q "version.* 4\.8\.6"; then
        echo "error: Qt 4.8.6 ${tool%% *} is missing or does not run" >&2
        failed=1
    fi
done

if [ ! -f /opt/bb10-toolchain/lib/libclang_rt.builtins-armv7.a ]; then
    echo "error: compiler-rt builtins for armv7 are missing" >&2
    failed=1
fi

for file in libclang_rt.builtins-i386.a stack-protector.o crtbegin.o crtend.o; do
    if [ ! -f "/opt/bb10-toolchain/lib/qnx65-x86/$file" ]; then
        echo "error: compiler-rt $file for QNX 6.5.0 x86 is missing" >&2
        failed=1
    fi
done

if [ ! -f "${QNX_TARGET:-/opt/bb10-sdk/target/qnx6}/x86/lib/crt1.o" ]; then
    echo "error: the x86 half of the target sysroot is missing" >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    exit 1
fi

if ! "$target-ld" -V 2>&1 | grep -q armnto; then
    echo "error: GNU ld does not contain armnto emulation" >&2
    exit 1
fi

echo "modern compiler: $(clang++ --version | head -n 1)"
echo "modern linker: $($target-ld --version | head -n 1)"
echo "builder process architecture: $(uname -m)"
echo "linker output profile: armnto (GNU ld calls this an emulation; no CPU emulation)"
echo "qcc: absent"
echo "BB10 Cascades SDK: present"
echo "Qt host tools: $(/opt/bb10-qt4/bin/moc -v 2>&1)"

# Configure, moc, compile and link a probe with the real toolchain file and link
# rules: QNX predefines, ABI sizes, a Q_OBJECT class and every runtime helper.
selftest=$(mktemp -d)
if ! cmake -S /opt/bb10-cmake/selftest -B "$selftest" \
        -DCMAKE_TOOLCHAIN_FILE=/opt/bb10-toolchain.cmake >"$selftest.log" 2>&1 || \
   ! cmake --build "$selftest" >>"$selftest.log" 2>&1; then
    cat "$selftest.log" >&2
    echo "error: toolchain self-test failed" >&2
    exit 1
fi
rm -rf "$selftest" "$selftest.log"
echo "self-test: moc, QNX ABI checks and runtime helpers link"

# The gcc-compatible driver used by cgo and other "cc"-driven builds.
probe=$(mktemp -d)
printf '#include <stdio.h>\nint main(void) { return printf("ok") < 0; }\n' > "$probe/c.c"
printf '#include <QString>\nint main() { return QString("ok").size() != 2; }\n' > "$probe/cxx.cpp"
if ! bb10-cc -O2 -o "$probe/c" "$probe/c.c" || \
   ! bb10-c++ -O2 -o "$probe/cxx" "$probe/cxx.cpp" -lQtCore; then
    echo "error: bb10-cc/bb10-c++ cannot build a program" >&2
    exit 1
fi
rm -rf "$probe"
echo "bb10-cc/bb10-c++: C and C++ programs link"

# QNX 6.5.0 (x86): a program and a shared library with a constructor, a
# thread-local variable and 64-bit division link from the SDK's x86 half and
# use only what 6.5.0's libraries have. The check must also catch a program
# that uses a BB10-only function.
probe=$(mktemp -d)
cat > "$probe/lib.c" <<'EOF'
#include <unistd.h>
static __thread int counter;
static volatile int pid;
__attribute__((constructor)) static void init(void) { pid = getpid(); }
int probe_pid(void) { return pid + counter++; }
unsigned long long probe_div(unsigned long long a, unsigned long long b) { return a / b; }
EOF
cat > "$probe/main.c" <<'EOF'
#include <stdio.h>
int probe_pid(void);
unsigned long long probe_div(unsigned long long, unsigned long long);
int main(int argc, char **argv) { return printf("%d %llu\n", probe_pid(), probe_div(argc, 3)) < 0; }
EOF
printf '#include <string.h>\nint main(int argc, char **argv) { return (int)strnlen(argv[0], 8); }\n' > "$probe/bb10only.c"
# regcomp is only in the static libc, whose objects use the stack protector.
printf '#include <regex.h>\nint main(int argc, char **argv) { regex_t r; return regcomp(&r, argv[0], 0); }\n' > "$probe/static.c"
if ! qnx65-cc -O2 -fPIC -shared -Wl,-soname,libprobe.so.1 -o "$probe/libprobe.so.1" "$probe/lib.c" || \
   ! qnx65-cc -O2 -o "$probe/main" "$probe/main.c" "$probe/libprobe.so.1" || \
   ! qnx65-cc -O2 -o "$probe/static" "$probe/static.c" || \
   ! qnx65-cc -O2 -fno-builtin -o "$probe/bb10only" "$probe/bb10only.c"; then
    echo "error: qnx65-cc cannot build a program" >&2
    exit 1
fi
if ! llvm-readelf -S "$probe/libprobe.so.1" | grep -q '\.ctors'; then
    echo "error: qnx65-cc did not put the constructor in .ctors" >&2
    exit 1
fi
names=/opt/bb10-toolchain/share/qnx65-symbols
if ! qnx65-check-names "$probe/main" "$probe/libprobe.so.1" "$names/libc.so.3.txt" >/dev/null || \
   ! qnx65-check-names "$probe/libprobe.so.1" "$names/libc.so.3.txt" >/dev/null || \
   ! qnx65-check-names "$probe/static" "$names/libc.so.3.txt" >/dev/null; then
    echo "error: a qnx65-cc program needs symbols QNX 6.5.0 lacks" >&2
    exit 1
fi
if qnx65-check-names "$probe/bb10only" "$names/libc.so.3.txt" >/dev/null 2>&1; then
    echo "error: qnx65-check-names accepted a BB10-only function (strnlen)" >&2
    exit 1
fi
rm -rf "$probe"
echo "qnx65-cc: a QNX 6.5.0 x86 program and shared library link; qnx65-check-names works"

if [ "${1:-}" != "--image-build" ]; then
    echo "toolchain is ready"
fi
