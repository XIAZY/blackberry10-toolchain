#!/usr/bin/env python3
"""gcc-compatible C driver for QNX 6.5.0.

QNX 6.5.0 is a different system from BB10, with its own SDK, and this is its
driver; bb10-cc is BB10's. QNX_ARCH chooses the architecture: only x86 (the
default) is provided. arm is refused: see ARM_REFUSED below.

Builds against QNX SDP 6.5.0's own headers, libraries and start-up files,
which the image takes from QNX's Linux installer (qnx65-sdk-extract). clang
compiles for the i386 SysV ABI with the Linux-specific parts of its driver
turned off, and lld links. gcc 4.4.2's crtbegin/crtend and libgcc, from the
same installer, run the constructors and supply the 64-bit arithmetic and the
emulated thread-local storage, as they do for QNX's own compiler. Arguments
are passed to clang in the order given, so --start-group and the like work.
"""
import os
import subprocess
import sys

SDK = os.environ.get("QNX65_SDK", "/opt/qnx65-sdk")
ARM_REFUSED = ("qnx65-cc: QNX 6.5.0 on ARM is not provided: QNX's installer for x86 targets has no ARM "
               "target libraries")
ARCH = os.environ.get("QNX_ARCH", "x86")
if ARCH == "arm":
    sys.exit(ARM_REFUSED)
if ARCH != "x86":
    sys.exit("qnx65-cc: QNX_ARCH must be x86, not " + ARCH)
TARGET = SDK + "/qnx6"
GCC = SDK + "/x86/usr/lib/gcc/i486-pc-nto-qnx6.5.0/4.4.2"
LIB = TARGET + "/x86/lib"
USR_LIB = TARGET + "/x86/usr/lib"


def compile_flags():
    resource = subprocess.run(["clang", "-print-resource-dir"], capture_output=True, text=True, check=True).stdout.strip()
    # -march=i486: the default of QNX 6.5.0's own compiler; no SSE. A later
    #   -march or -msse2 on the command line overrides it.
    # -mstack-alignment=4: 6.5.0 only guarantees a 4-byte aligned stack, so
    #   code that needs more (SSE) realigns it itself.
    # -femulated-tls: the 6.5.0 loader has no PT_TLS support; libgcc's
    #   __emutls_get_address does it on top of pthread keys.
    # -fno-use-init-array: constructors go in .ctors, run by gcc's crtbegin.o
    #   from DT_INIT, as with QNX's own compiler.
    # -fno-stack-protector: 6.5.0's libc has no __stack_chk_fail.
    # _QNX_SOURCE: as bb10-cc passes it. Under a strict C standard
    #   (-std=c11 rather than gnu11) QNX's headers hide POSIX without it.
    # clang's own headers (stddef.h, stdarg.h, the x86 intrinsics, ...) come
    # before the SDK's.
    return ["--target=i386-pc-linux-gnu", "-march=i486", "-fno-pic",
            "-mstack-alignment=4", "-fno-omit-frame-pointer", "-femulated-tls", "-fno-use-init-array",
            "-fno-stack-protector", "-nostdinc",
            "-U__linux__", "-U__linux", "-Ulinux", "-U__gnu_linux__", "-Uunix",
            "-U__FLOAT128__", "-U__SIZEOF_FLOAT128__",
            "-D__QNX__", "-D__QNXNTO__", "-D__unix__", "-D__unix", "-D__ELF__", "-D__X86__", "-D__i386__",
            "-D__LITTLEENDIAN__", "-D_QNX_SOURCE", "-Wno-unused-command-line-argument",
            "-isystem", resource + "/include", "-isystem", TARGET + "/usr/include"]


def link_flags():
    # The shape of the 6.5.0 compiler's output: SysV hash, DT_RPATH, no RELRO
    # or GNU_STACK segments, read-only data in the text segment. gcc 4.4's
    # libgcc.a does not hide its symbols, so --exclude-libs keeps them private
    # to each program and library.
    return ["-fuse-ld=lld", "-nostdlib", "-Wl,--hash-style=sysv", "-Wl,--disable-new-dtags", "-Wl,-z,norelro",
            "-Wl,-z,nognustack", "-Wl,--no-rosegment", "-Wl,--build-id=none", "-Wl,--exclude-libs,libgcc.a",
            "-L" + LIB, "-L" + USR_LIB, "-Wl,-rpath-link=" + LIB + ":" + USR_LIB]


def main():
    args = [a for a in sys.argv[1:] if a != "-pie"]  # 6.5.0 programs are not position independent
    cmd = ["clang"] + compile_flags()
    if not args or any(a in ("-c", "-S", "-E", "-M", "-MM", "-fsyntax-only", "--version", "-v", "-dumpversion",
                             "-dumpmachine") or a.startswith("-print-") for a in args):
        cmd += args + ["-fno-stack-protector"]
    elif "-shared" in args:
        # PIC crtbegin/crtend and libgcc; libcS.a holds the parts of libc that
        # shared objects link statically.
        pic = GCC + "/pic"
        cmd += (["-fPIC"] + link_flags() + [LIB + "/crti.o", pic + "/crtbegin.o"] + args
                + ["-fno-stack-protector", "-x", "none", pic + "/libgcc.a", "-lc", "-Wl,-Bstatic", "-lcS",
                   "-Wl,-Bdynamic", pic + "/libgcc.a", pic + "/crtend.o", LIB + "/crtn.o"])
    else:
        # The static libc follows the shared one, as with QNX's own compiler:
        # some libc functions (popen, glob, regcomp, ...) are only in libc.a.
        cmd += (link_flags() + ["-no-pie", "-Wl,--dynamic-linker=/usr/lib/ldqnx.so.2", "-Wl,--image-base=0x08048000",
                                LIB + "/crt1.o", LIB + "/crti.o", GCC + "/crtbegin.o"] + args
                + ["-fno-stack-protector", "-x", "none", GCC + "/libgcc.a", "-lc", "-Wl,-Bstatic", "-lc",
                   "-Wl,-Bdynamic", GCC + "/libgcc.a", GCC + "/crtend.o", LIB + "/crtn.o"])
    if os.environ.get("QNX65_CC_VERBOSE"):
        print(" ".join(cmd), file=sys.stderr)
    return subprocess.call(cmd)


sys.exit(main())
